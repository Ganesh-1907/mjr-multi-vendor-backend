# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ecommerce

# JWT
JWT_SECRET=<your-secret>
JWT_EXPIRES_IN=86400000

# CORS - comma-separated list of allowed origins (include the Vite dev server)
CORS_ORIGINS=http://localhost:4200,http://localhost:1200,http://localhost:5173,http://localhost:5175

# Email (SMTP - Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail>
SMTP_PASS=<your-app-password>
EMAIL_FROM=<your-gmail>

# Razorpay
RAZORPAY_KEY_ID=<test-or-live-key-id>
RAZORPAY_KEY_SECRET=<test-or-live-key-secret>

# Upload
MAX_FILE_SIZE=10485760

# Cloudflare R2
R2_ENDPOINT=<r2-endpoint>
R2_ACCESS_KEY=<r2-access-key>
R2_SECRET_KEY=<r2-secret-key>
R2_BUCKET=<r2-bucket>
R2_PUBLIC_URL=<optional-public-url>
API_BASE_URL=<optional-api-base-url>
